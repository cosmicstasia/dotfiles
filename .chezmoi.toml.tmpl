{{- $gitName := promptStringOnce . "gitName" "Git name" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "Git email" -}}
{{- /*
  Each machine signs commits and authenticates to git hosts with its own
  ~/.ssh/id_ed25519, read straight from disk: no agent or password manager.
  The public keys that verify signatures live in .chezmoidata/git.toml.
*/ -}}
{{- $gitSigningKeyFile := promptStringOnce . "gitSigningKeyFile" "Git SSH signing key file (empty to skip signing)" (printf "%s/.ssh/id_ed25519" .chezmoi.homeDir) -}}
{{- $sshAuthorizedKeys := list -}}
{{- if hasKey . "sshAuthorizedKeys" -}}
{{-   $sshAuthorizedKeys = get . "sshAuthorizedKeys" -}}
{{- else -}}
{{-   $sshAuthorizedKey := promptString "SSH public key allowed to log in to this machine (optional; add more to sshAuthorizedKeys later)" -}}
{{-   if $sshAuthorizedKey -}}
{{-     $sshAuthorizedKeys = list $sshAuthorizedKey -}}
{{-   end -}}
{{- end -}}
{{- $obsidianVault := promptStringOnce . "obsidianVault" "Obsidian vault path (optional)" -}}
{{- $talosConfig := promptStringOnce . "talosConfig" "Talos config path (optional)" -}}
{{- $herdrWorkspace := promptStringOnce . "herdrWorkspace" "Herdr workspace path" -}}
{{- $defaultPeerName := "omarchy" -}}
{{- $defaultPeerAddr := "omarchy.tailb320db.ts.net" -}}
{{- if ne .chezmoi.os "darwin" -}}
{{-   $defaultPeerName = "macbook" -}}
{{-   $defaultPeerAddr = "anastasia@cash-macbook-pro.tailb320db.ts.net" -}}
{{- end -}}
{{- $peerName := promptStringOnce . "peerName" "name for the other machine in tuios and herdr (empty to skip)" $defaultPeerName -}}
{{- $peerAddr := promptStringOnce . "peerAddr" "ssh address of the other machine" $defaultPeerAddr -}}
{{- $nineRouterApiKey := promptStringOnce . "nineRouterApiKey" "9router API key for omp (optional, stays local)" -}}

[data]
gitName = {{ $gitName | quote }}
gitEmail = {{ $gitEmail | quote }}
gitSigningKeyFile = {{ $gitSigningKeyFile | quote }}
obsidianVault = {{ $obsidianVault | quote }}
talosConfig = {{ $talosConfig | quote }}
herdrWorkspace = {{ $herdrWorkspace | quote }}
peerName = {{ $peerName | quote }}
peerAddr = {{ $peerAddr | quote }}
nineRouterApiKey = {{ $nineRouterApiKey | quote }}
sshAuthorizedKeys = [{{ range $i, $key := $sshAuthorizedKeys }}{{ if $i }}, {{ end }}{{ $key | quote }}{{ end }}]
