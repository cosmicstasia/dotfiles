#!/bin/sh
set -eu

# Re-run when the shell or tool config changes:
# {{ include "dot_config/nushell/config.nu.tmpl" | sha256sum }}
# {{ include "dot_config/mise/config.toml" | sha256sum }}
config_dir="$HOME/.config/nushell"
autoload_dir="$config_dir/vendor/autoload"
mkdir -p "$config_dir" "$autoload_dir"

# Tools come from mise; the shims resolve them without an activated shell.
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export PATH

# starship embeds its own absolute path, which under mise names a version
# directory; call it by name so upgrades do not break the prompt.
command -v starship >/dev/null 2>&1 && starship init nu \
  | sed 's#\^/[^ ]*/starship #^starship #g' > "$config_dir/starship.nu"
command -v zoxide >/dev/null 2>&1 && zoxide init nushell > "$config_dir/zoxide.nu"
command -v carapace >/dev/null 2>&1 && carapace _carapace nushell > "$config_dir/carapace.nu"
if command -v atuin >/dev/null 2>&1; then
  atuin init nu | awk '
    /name: atuin/ {
      binding++
      if (binding == 2) sub("name: atuin", "name: atuin_up")
    }
    { print }
  ' > "$config_dir/atuin.nu"
fi
command -v tv >/dev/null 2>&1 && tv init nu > "$autoload_dir/tv.nu"

if [ -x "$HOME/.tmux/plugins/tpm/bin/install_plugins" ]; then
  "$HOME/.tmux/plugins/tpm/bin/install_plugins" || true
fi
