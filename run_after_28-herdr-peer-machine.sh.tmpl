{{- $peers := get . "peers" | default list -}}
{{- if $peers -}}
#!/bin/sh
# Save each other machine from the peers list in herdr, so its workspaces
# and agents show in the sidebar under its name, as tuios lists it under
# [hosts]. Runs on every apply; only reads herdr's machine list unless a
# peer is missing, and then lets `herdr machine add` start that peer's
# herdr server and save its profile.
set -eu

PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export PATH
command -v herdr >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

{{ range $peers }}
name={{ .name | quote }}
addr={{ .addr | quote }}

if ! herdr machine list --json 2>/dev/null \
  | jq -e --arg t "$addr" 'any(.[]; .target == $t)' >/dev/null; then
  # A bounded, prompt-free ssh probe keeps an asleep or locked peer from
  # stalling chezmoi apply.
  if ssh -o BatchMode=yes -o ConnectTimeout=8 "$addr" true </dev/null 2>/dev/null \
    && herdr machine add "$addr" --label "$name" --remote-session default </dev/null; then
    :
  else
    echo "herdr: could not save $name ($addr) yet; chezmoi apply retries it." >&2
    echo "  Check that 'ssh $addr' works without a prompt, then re-run chezmoi apply." >&2
  fi
fi
{{ end -}}
{{- end -}}
