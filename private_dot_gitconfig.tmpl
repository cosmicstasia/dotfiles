{{- $gitName := get . "gitName" | default "" -}}
{{- $gitEmail := get . "gitEmail" | default "" -}}
{{- $gitSigningKeyFile := get . "gitSigningKeyFile" | default "" -}}
{{- if or $gitName $gitEmail }}
[user]
	name = {{ $gitName }}
	email = {{ $gitEmail }}
{{- if $gitSigningKeyFile }}
	signingkey = {{ $gitSigningKeyFile }}
{{- end }}
{{- end }}
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- if $gitSigningKeyFile }}
[gpg]
	format = ssh
[gpg "ssh"]
	# Signs with the key file in user.signingkey; ssh-keygen reads it directly.
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}
