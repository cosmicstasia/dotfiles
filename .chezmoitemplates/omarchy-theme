{{- /*
  Prints the directory holding the active Omarchy theme when this machine runs
  Omarchy, and nothing otherwise. Omarchy 4 is a package (/usr/share/omarchy)
  and keeps the theme under ~/.local/state; Omarchy 3.x is a checkout in
  ~/.local/share/omarchy and keeps it under ~/.config. Templates use this to
  hand theming to Omarchy on the desktop while the Mac keeps its own colours:

    {{- $omarchyTheme := includeTemplate "omarchy-theme" . | trim -}}
*/ -}}
{{- $home := .chezmoi.homeDir -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if stat (joinPath $home ".local/state/omarchy/current") -}}
{{-     joinPath $home ".local/state/omarchy/current/theme" -}}
{{-   else if stat (joinPath $home ".config/omarchy/current") -}}
{{-     joinPath $home ".config/omarchy/current/theme" -}}
{{-   else if or (stat "/usr/share/omarchy") (stat (joinPath $home ".local/share/omarchy")) -}}
{{-     joinPath $home ".local/state/omarchy/current/theme" -}}
{{-   end -}}
{{- end -}}
