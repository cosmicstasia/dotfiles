#!/bin/sh
# Install the herdr plugins listed in .chezmoidata/herdr.toml on any machine
# that lacks them. herdr keeps the checkouts and plugins.json as per-machine
# state, so chezmoi tracks only the list; `herdr plugin update` moves them
# forward. Re-runs when the list changes:
# {{ .herdrPlugins | toJson | sha256sum }}
set -eu

PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
export PATH
command -v herdr >/dev/null 2>&1 || exit 0

installed=$(herdr plugin list 2>/dev/null || true)

{{ range .herdrPlugins -}}
case "$installed" in
  *"[github:{{ .repo }}@"*) ;;
  *) herdr plugin install {{ .repo | quote }}{{ with get . "ref" }} --ref {{ . | quote }}{{ end }} --yes </dev/null ;;
esac
{{ end -}}
