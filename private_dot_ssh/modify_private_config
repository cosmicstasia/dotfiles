{{- /* chezmoi:modify-template */ -}}
{{- /*
  Puts a managed block at the top of ~/.ssh/config. The other machine of the
  pair (peerAddr) and the git hosts in .chezmoidata/git.toml use this
  machine's ~/.ssh/id_ed25519 straight from disk: no agent, no forwarding, no
  password manager. Other hosts, and the rest of the file, are left alone.
*/ -}}
{{- $rest := regexReplaceAll "(?s)# BEGIN chezmoi[^\n]*\n.*?# END chezmoi[^\n]*\n*" .chezmoi.stdin "" -}}
{{- $peerName := get . "peerName" | default "" -}}
{{- $peerAddr := get . "peerAddr" | default "" -}}
# BEGIN chezmoi (managed: edit private_dot_ssh/modify_private_config)
{{- if $peerAddr }}
{{- $host := regexReplaceAll "^.*@" $peerAddr "" }}
Host {{ if and $peerName (ne $peerName $host) }}{{ $peerName }} {{ end }}{{ $host }}
  HostName {{ $host }}
{{- if contains "@" $peerAddr }}
  User {{ regexReplaceAll "@.*$" $peerAddr "" }}
{{- end }}
  IdentityAgent none
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
{{- end }}
{{- range $git := get . "gitHosts" | default list }}

Host {{ $git.host }}
{{- if hasKey $git "port" }}
  Port {{ $git.port }}
{{- end }}
  User git
  IdentityAgent none
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
{{- end }}
# END chezmoi
{{ if $rest }}
{{ $rest }}
{{- end }}
