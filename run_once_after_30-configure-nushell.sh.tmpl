#!/bin/sh
set -eu

{{ if eq .chezmoi.os "linux" -}}
nu_path=/home/linuxbrew/.linuxbrew/bin/nu

if [ ! -x "$nu_path" ]; then
  echo "Nushell was not installed at $nu_path" >&2
  exit 1
fi

if ! grep -Fxq "$nu_path" /etc/shells; then
  printf '%s\n' "$nu_path" | sudo tee -a /etc/shells >/dev/null
fi

if [ "${SHELL:-}" != "$nu_path" ]; then
  chsh -s "$nu_path"
fi
{{ else -}}
# nix-darwin manages the macOS login shell and /etc/shells.
exit 0
{{ end -}}
