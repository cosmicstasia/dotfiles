{{- $sshAuthSock := get . "sshAuthSock" | default "" -}}
{{- $talosConfig := get . "talosConfig" | default "" -}}
$env.config.show_banner = false

overlay use starship.nu
overlay use zoxide.nu
source atuin.nu

use ($nu.default-config-dir | path join "mise.nu")

{{ if $sshAuthSock -}}
$env.SSH_AUTH_SOCK = {{ $sshAuthSock | quote }}
{{ else -}}
if "XDG_RUNTIME_DIR" in $env {
    $env.SSH_AUTH_SOCK = ($env.XDG_RUNTIME_DIR | path join "ssh-agent.socket")
}
{{ end -}}

alias python = python3
alias emacs = emacs -nw
alias oc = opencode
alias v = nvim
alias vim = nvim
alias vi = nvim
alias k = kubectl
alias lg = lazygit
alias cat = bat
alias cd = z
alias weather = curl wttr.in
alias py = python3
alias ".." = cd ..
alias docker = podman

let brew_prefix = if $nu.os-info.name == "macos" {
    "/opt/homebrew"
} else {
    "/home/linuxbrew/.linuxbrew"
}

let extra_paths = [
    ($brew_prefix | path join "bin")
    ($brew_prefix | path join "sbin")
    $"($env.HOME)/.cargo/bin"
    $"($env.HOME)/.bun/bin"
    $"($env.HOME)/.local/bin"
    "/Library/TeX/texbin"
]
$env.PATH = ($env.PATH | prepend ($extra_paths | where {|path| $path | path exists }) | uniq)

if (which brew | is-not-empty) {
    let java_prefix_result = (^brew --prefix openjdk@21 | complete)
    if $java_prefix_result.exit_code == 0 {
        let java_prefix = ($java_prefix_result.stdout | str trim)
        let java_home = ([
            ($java_prefix | path join "libexec/openjdk.jdk/Contents/Home")
            $java_prefix
        ] | where {|path| $path | path join "bin/java" | path exists } | get -o 0)

        if $java_home != null {
            $env.JAVA_HOME = $java_home
            $env.PATH = ($env.PATH | prepend ($java_home | path join "bin") | uniq)
        }
    }
}

if (which carapace | is-not-empty) {
    let carapace_completer = {|spans: list<string>|
        CARAPACE_LENIENT=1 carapace $spans.0 nushell ...$spans | from json
    }

    let external_completer = {|spans: list<string>|
        let expanded_alias = (
          scope aliases
          | where name == $spans.0
          | get -o 0.expansion
        )
        let resolved_spans = if $expanded_alias != null {
          $spans | skip 1 | prepend ($expanded_alias | split row " " | get 0)
        } else {
          $spans
        }
        do $carapace_completer $resolved_spans
    }

    $env.config = ($env.config | merge {
        completions: {
            external: {
                enable: true
                completer: $external_completer
            }
        }
    })
}

# Set Edit Mode to vi 
$env.config.edit_mode = 'vi'

$env.EDITOR = "nvim"
$env.KUBECONFIG = ($env.HOME | path join ".kube/config")
$env.BUN_INSTALL = ($env.HOME | path join ".bun")
{{ if $talosConfig -}}
$env.TALOSCONFIG = {{ $talosConfig | quote }}
{{ end -}}

use std/formats "from ndjson"
