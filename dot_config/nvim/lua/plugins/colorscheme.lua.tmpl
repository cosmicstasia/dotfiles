{{- /* Mac only. On Omarchy this renders empty, so chezmoi removes it and
  theme.lua (Omarchy's active theme) picks the colorscheme. */ -}}
{{- if not (includeTemplate "omarchy-theme" . | trim) -}}
return {
  {
    "catppuccin/nvim",
    name = "catppuccin",
    priority = 1000,
    opts = {
      flavour = "mocha",
      styles = {
        comments = { "italic" },
        conditionals = { "bold" },
        functions = { "bold" },
        keywords = { "bold" },
        loops = { "bold" },
        types = { "bold" },
      },
    },
  },
  {
    "LazyVim/LazyVim",
    opts = {
      colorscheme = "catppuccin-mocha",
    },
  },
}
{{- end }}
