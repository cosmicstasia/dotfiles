{{- $omarchyTheme := includeTemplate "omarchy-theme" . | trim -}}
{{- if $omarchyTheme -}}
# Omarchy owns colours, font and opacity (its theme plus
# /etc/xdg/kitty/kitty.conf); this file only adds behaviour.
{{- if stat "/etc/xdg/kitty/kitty.conf" }}
include /etc/xdg/kitty/kitty.conf
{{- end }}
include {{ $omarchyTheme }}/kitty.conf
{{- else -}}
include themes/noctalia.conf
{{- end }}

editor nvim

{{ if not $omarchyTheme -}}
font_size 14.0
draw_minimal_borders yes
inactive_text_alpha 0.7
background_opacity 0.90
{{ end -}}
confirm_os_window_close 0
# zsh opens a plain shell; tuios is opt-in via TUIOS_AUTOSTART=1 (see ~/.zshrc).
shell /bin/zsh --login

{{ if eq .chezmoi.os "darwin" -}}
macos_titlebar_color background
map cmd+c copy_to_clipboard
map cmd+v paste_from_clipboard
map cmd+w close_window
map cmd+shift+n new_os_window
map cmd+d launch --location=hsplit --cwd=current
map cmd+shift+d launch --location=vsplit --cwd=current
{{ else -}}
map ctrl+shift+c copy_to_clipboard
map ctrl+shift+v paste_from_clipboard
map ctrl+shift+w close_window
map ctrl+shift+enter new_os_window
map ctrl+shift+d launch --location=hsplit --cwd=current
map ctrl+shift+alt+d launch --location=vsplit --cwd=current
{{ end -}}
