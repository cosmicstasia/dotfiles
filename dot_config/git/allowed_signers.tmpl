{{- $gitEmail := get . "gitEmail" | default "" -}}
{{- if $gitEmail -}}
{{-   range $key := .git.signerKeys | default list -}}
{{-     $parts := splitList " " (trim $key) -}}
{{-     if ge (len $parts) 2 -}}
{{ $gitEmail }} {{ index $parts 0 }} {{ index $parts 1 }}
{{ end -}}
{{-   end -}}
{{- end -}}
