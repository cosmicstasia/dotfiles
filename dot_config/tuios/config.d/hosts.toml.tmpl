{{- $peerName := get . "tuiosPeerName" | default "" -}}
{{- $peerAddr := get . "tuiosPeerAddr" | default "" -}}
{{- if and $peerName $peerAddr -}}
# The other machine of the MacBook/Omarchy pair. Its tuios sessions show in
# the sidebar under this name; `tuios attach --host {{ $peerName }}` opens one.
# Rendered by chezmoi from tuiosPeerName/tuiosPeerAddr in chezmoi.toml.
# tuios asks before it widens [hosts]: run `tuios config apply` outside tuios.
[hosts.{{ $peerName }}]
addr = {{ $peerAddr | quote }}
connect_timeout = 10
{{ end -}}
