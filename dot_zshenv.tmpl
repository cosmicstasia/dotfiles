{{- $talosConfig := get . "talosConfig" | default "" -}}
# Environment for every zsh: login, interactive, scripts, `ssh host cmd`,
# and the panes tuios and herdr spawn. Keep this file fast and silent.
# Managed by chezmoi: edit ~/.local/share/chezmoi/dot_zshenv.tmpl.

export EDITOR=nvim
export VISUAL=nvim
export TERMINAL=kitty
export KUBECONFIG="$HOME/.kube/config"
export BUN_INSTALL="$HOME/.bun"
{{ if $talosConfig -}}
export TALOSCONFIG={{ $talosConfig | quote }}
{{ end -}}
# User directories go in front of the system PATH. mise shims make the
# mise-managed tools visible to non-interactive shells too (scripts, editors,
# the ssh link `tuios hosts` opens to the other machine); interactive shells
# replace them with real paths through `mise activate` in ~/.zshrc.
__dotfiles_path() {
  typeset -gU path
  local -a front
  local dir
  for dir in \
    "$HOME/.local/bin" \
    "$HOME/.local/share/mise/shims" \
    "$HOME/.cargo/bin" \
    "$BUN_INSTALL/bin" \
    "$HOME/.herdr-projects/data/bin" \
    "$HOME/.local/share/omarchy/bin" \
  ; do
    [[ -d $dir ]] && front+=("$dir")
  done
  path=("${front[@]}" "${path[@]}")
}
__dotfiles_path
