tap "domt4/autoupdate", trusted: true
tap "jayadamsmorgan/yatoro"
tap "nikitabobko/tap"
tap "rjyo/moshi", trusted: true

# macOS-only native packages. The shared CLI toolchain lives in
# ~/.config/mise/config.toml; Homebrew keeps GUI apps and the formulae mise
# cannot install (system libraries, daemons, compiled toolchains).
# The Omarchy desktop installs the same set with pacman in
# run_onchange_after_20-native-packages.sh.

# System libraries and compiled tools
brew "binutils"
brew "binwalk"
brew "cava"
brew "emacs"
brew "ffmpeg"
brew "fortune"
brew "gdal"
brew "git"
brew "git-lfs"
brew "imagemagick"
brew "libiodbc"
brew "libpq"
brew "luarocks"
brew "mpv"
brew "nmap"
brew "octave"
brew "picocom"
brew "plantuml"
brew "poppler"
brew "postgresql@18"
brew "pv"
brew "qemu"
brew "ruby"
brew "scrcpy"
brew "tesseract"
brew "tmux"
brew "tree"
brew "valkey"
brew "vim"
brew "wget"
brew "whois"

# Reverse engineering (need a JDK; mise provides it)
brew "apktool"
brew "jadx"

# Nix tooling for nix-darwin
brew "nixfmt"
brew "statix"

# Containers
brew "colima"
brew "docker"
brew "docker-buildx"
brew "docker-compose"
brew "podman"

# macOS-only command-line tools
brew "ical-buddy"
brew "mole"

# Applications
cask "nikitabobko/tap/aerospace", trusted: true
cask "android-platform-tools"
cask "angry-ip-scanner"
cask "arduino-ide"
cask "balenaetcher"
cask "battery"
cask "chatgpt"
cask "codex-app"
cask "dbeaver-community"
cask "font-fira-code"
cask "font-hack-nerd-font"
cask "ghostty"
cask "inkscape"
cask "kdenlive"
cask "kitty"
cask "librecad"
cask "macfuse"
cask "mark-text"
cask "mattermost"
cask "mitmproxy"
cask "mongodb-compass"
cask "notion"
cask "notion-calendar"
cask "obs"
cask "openmtp"
cask "pearcleaner"
cask "qbittorrent"
cask "qflipper"
cask "raspberry-pi-imager"
cask "redis-insight"
cask "signal"
cask "stats"
cask "steam"
cask "texstudio"
