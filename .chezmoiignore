README.md
**/.DS_Store
**/.git
**/.git/**

# Emacs runtime and machine-generated state
.config/emacs/.cache
.config/emacs/.local
.config/emacs/auto-save-list
.config/emacs/eln-cache
.config/emacs/elpa
.config/emacs/eshell
.config/emacs/transient

# Monitor layout and input devices are genuinely per-machine (the desktop's
# ultra-wide display and the laptop's built-in panel/touchpad share no
# sensible default), so they are never synced.
.config/hypr/monitors.lua
.config/hypr/input.lua
.config/emacs/tree-sitter
.config/emacs/custom.el~
.config/emacs/matugen-colors.el
.config/emacs/projects
.config/emacs/recentf.eld
.config/emacs/tramp

# Nushell integrations generated per machine by
# run_onchange_after_25-generate-nushell-integrations.sh; they embed
# machine-specific binary paths, so they are never shared.
.config/nushell/atuin.nu
.config/nushell/carapace.nu
.config/nushell/mise.nu
.config/nushell/starship.nu
.config/nushell/zoxide.nu
.config/nushell/vendor/autoload/tv.nu

# tuios backups and runtime state
.config/tuios/*.bak*

# Theming: on Omarchy every app follows the Omarchy theme; this check
# guards templates in case Omarchy itself is ever absent.
{{ if includeTemplate "omarchy-theme" . | trim }}
.config/kitty/themes
# omarchy-theme-set-pi writes this on every theme change.
.pi/agent/themes/omarchy-system.json
# The Omarchy theme-set hook keeps this in step with the desktop theme.
.config/emacs/current-theme
{{ else }}
.config/omarchy
.config/btop/themes
.config/nvim/lua/plugins/theme.lua
.config/nvim/lua/plugins/omarchy-theme-hotreload.lua
.config/nvim/lua/plugins/all-themes.lua
.config/nvim/lua/plugins/lualine-transparent.lua
.config/nvim/plugin
.omp/agent/themes
.config/tuios/config.d/omarchy.toml
{{ end }}
